# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project Settings > Environment Variables.

# Contact form email delivery (https://resend.com). The FROM address must be on a
# domain verified in Resend, for example website@silver-fox-consulting.us.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@silver-fox-consulting.us
CONTACT_FROM_EMAIL="Silver Fox Website <website@silver-fox-consulting.us>"

# Cloudflare Turnstile spam protection (Cloudflare dashboard > Turnstile).
# For local testing you can use Cloudflare's always-pass test keys:
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
